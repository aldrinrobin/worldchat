# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed origin for CORS and Socket.IO (comma-separated for multiple)
# In production, set this to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (messages per window)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=5000
RATE_LIMIT_MUTE_MS=30000

# Connection limits per IP
MAX_CONNECTIONS_PER_IP=5

# Maximum socket payload size in bytes
MAX_SOCKET_PAYLOAD=2048
